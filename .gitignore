*.iml
.gradle
.idea
.DS_Store
build
captures
.externalNativeBuild
.cxx
local.properties
xcuserdata

gitignore
#-------------------------------------------------------------------------------
# Generic IDE/Editor files
#-------------------------------------------------------------------------------
.idea/
*.iml
*.iws
*.ipr
.project
.classpath
.DS_Store
Thumbs.db
desktop.ini

#-------------------------------------------------------------------------------
# Build Output & Temporary Files
#-------------------------------------------------------------------------------
build/
out/
captures/
*.apk
*.aab
*.ap_
*.aar
*.jar
*.war
*.ear
*.zip
*.tar.gz
*.rar

#-------------------------------------------------------------------------------
# Gradle
#-------------------------------------------------------------------------------
.gradle/
gradle-app.setting
gradle/wrapper/gradle-wrapper.properties # Consider keeping if you want to enforce Gradle version
!gradle-wrapper.jar # Typically committed
local.properties # Contains SDK path, API keys, etc. - VERY IMPORTANT TO IGNORE
gradle.properties # Can contain sensitive info, or be user-specific.
                  # If you have a gradle.properties with non-sensitive project-wide settings,
                  # you can commit that and have developers use local.properties for overrides.

#-------------------------------------------------------------------------------
# Kotlin & KMM specific
#-------------------------------------------------------------------------------
*.class
*.kexe
*.klib
*.knm
*.linkdata/
*.bc
*.l
*.so
*.o
*.obj
*.h
*.def
*.su
*.gcno
*.gcda
*.gcov
shared/build/ # KMM shared module build artifacts
shared/src/iosMain/kotlin/.supportedKotlinVersions # Generated by Kotlin/Native
shared/src/commonMain/kotlin/.supportedKotlinVersions # Generated by Kotlin/Native
shared/src/androidMain/kotlin/.supportedKotlinVersions # Generated by Kotlin/Native
shared/cocoapods.sh # Generated script
shared/Shared.podspec # Generated Cocoapods spec
shared/build/cocoapods/ # Cocoapods build artifacts
shared/build/xcode-frameworks/ # Generated frameworks for iOS
shared/build/bin/ # K/N binaries
shared/build/tmp/ # K/N temporary files
shared/build/generated/ # Generated code (e.g., from Apollo, SQLDelight if not directly in src)
shared/src/iosMain/resources/resourcebundles/ # If you manage iOS resources this way

#-------------------------------------------------------------------------------
# Android specific
#-------------------------------------------------------------------------------
androidApp/build/
androidApp/src/main/assets/ # If you have specific assets you don't want to commit, add here
androidApp/src/main/res/raw/ # Same as above
androidApp/src/main/jniLibs/ # If prebuilt native libs are added locally and not via Gradle
androidApp/release/ # Release build outputs
androidApp/profile/ # Profile build outputs
*.jks # Keystore files - VERY IMPORTANT TO IGNORE
*.keystore
*signing*.properties # Signing configurations

#-------------------------------------------------------------------------------
# iOS specific (Xcode)
#-------------------------------------------------------------------------------
# Xcode
## User specific
xcuserdata/
*.xcuserdatad/
*.xcworkspace/contents.xcworkspacedata # If you commit .xcworkspace, but some user-specific parts should be ignored

## Build generated
DerivedData/
*.moved-aside
*.hmap
*.ipa
*.app
*.dSYM/
*.profraw

# Cocoapods
Pods/                   # Generally recommended to commit Pods directory for reproducible builds
                        # UNLESS your team prefers to run `pod install` on every clone/checkout.
                        # If you ignore Pods/, ensure Podfile.lock is committed.
!Pods/! রাখে Pods/.gitattributes
!Pods/! রাখে Pods/Manifest.lock
!Pods/! রাখে Pods/Target\ Support\ Files/ # Keep some essential support files even if Pods/ itself is ignored

# If you choose NOT to commit the Pods directory:
# Pods/

# Carthage
Carthage/Build/
Carthage/Checkouts/

# Swift Package Manager
.swiftpm/build/
.build/

#-------------------------------------------------------------------------------
# Secrets / Sensitive Configuration
# (Add any files that might contain API keys, passwords, etc.)
# Often these are managed by having a template file committed
# and the actual file (ignored) created by each developer.
# e.g., secrets.properties, config.json
#-------------------------------------------------------------------------------
# secrets.properties
# config/local.json

#-------------------------------------------------------------------------------
# Operating System files
#-------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
.Spotlight-V100
.Trashes
__MACOSX/

# Windows
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# Linux
*~
#-------------------------------------------------------------------------------
# Logs
#-------------------------------------------------------------------------------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

#-------------------------------------------------------------------------------
# Other common ignores
#-------------------------------------------------------------------------------
.env # Environment variables, often contains secrets
.env.*.local
.env.local
/.kotlin/
/.kotlin/
